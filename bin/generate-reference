const RATE_LIMIT = [
    'limit' => ['X-RateLimit-Limit', 'The number of requests the bucket of the account holds.'],
    'remaining' => ['X-RateLimit-Remaining', 'The number of requests left in the bucket.'],
    'resetInSeconds' => ['X-RateLimit-Reset', 'The seconds until the bucket is full again.'],
    'resetsAt' => ['', 'The time the answer was received plus `resetInSeconds()`.'],
