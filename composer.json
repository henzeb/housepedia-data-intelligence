{
    "name": "henzeb/housepedia-data-intelligence",
    "description": "Framework-independent PHP SDK for the Housepedia Data Intelligence API",
    "keywords": [
        "henzeb",
        "housepedia",
        "huispedia",
        "housepedia data intelligence",
        "huispedia data intelligence",
        "data intelligence",
        "real estate",
        "property data",
        "valuation",
        "woz",
        "bag",
        "netherlands",
        "sdk",
        "dutch",
        "energy label",
        "kadaster",
        "cbs",
        "address",
        "postcode",
        "geocoding",
        "psr-18",
        "vastgoed",
        "woning",
        "woningwaarde",
        "waardebepaling",
        "taxatie",
        "energielabel",
        "adres",
        "buurt",
        "makelaar"
    ],
    "homepage": "https://github.com/henzeb/housepedia-data-intelligence",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Henze Berkheij",
            "email": "henzeberkheij@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "composer-runtime-api": "^2.0",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0.1",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-factory-implementation": "^1.0",
        "psr/http-message": "^1.1|^2.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.15.2|^8.0",
        "laravel/pint": "^1.30",
        "pestphp/pest": "^4.3.2|^5.0",
        "php-http/httplug": "^2.4.1",
        "php-http/mock-client": "^1.6.1",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Henzeb\\Housepedia\\Data\\Intelligence\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-parallel": "vendor/bin/pest --parallel",
        "test-coverage-txt": "vendor/bin/pest --coverage",
        "test-coverage": "XDEBUG_MODE=coverage vendor/bin/pest --coverage-html coverage",
        "test-dox": "vendor/bin/pest --testdox",
        "test-mutate": "XDEBUG_MODE=coverage vendor/bin/pest --mutate",
        "test-live": "vendor/bin/pest --testsuite=Live --group=live",
        "test-live-free": "vendor/bin/pest --testsuite=Live --group=live-free",
        "test-live-paid": "vendor/bin/pest --testsuite=Live --group=live-paid",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "format-check": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
